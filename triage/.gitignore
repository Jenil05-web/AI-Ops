# Environment & secrets
.env
*.env
!.env.example

# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
build/
dist/
.Python

# Virtual environments
venv/
env/
.venv/
ENV/

# Jupyter
.ipynb_checkpoints/

# Data (raw/processed data shouldn't live in git — too large, and often has license restrictions)
data/raw/*
data/processed/*
!data/raw/.gitkeep
!data/processed/.gitkeep

# Model artifacts (large binary files, regenerable from training script)
models/*
!models/.gitkeep

# Logs
logs/*
!logs/.gitkeep

# OS/editor junk
.DS_Store
Thumbs.db
.vscode/
.idea/

# Pytest / coverage
.pytest_cache/
.coverage
htmlcov/